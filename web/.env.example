# EdgeBoard web app environment variables.
# Copy this file to `web/.env.local` and fill in real values.
#
# Only the browser-safe Supabase vars belong here. The read path uses the
# anon key only — keep SUPABASE_SERVICE_ROLE_KEY out of the web app.

# The /early-access waitlist form (app/api/waitlist) writes signups into the Supabase `waitlist`
# table using the anon key above — no separate waitlist service or key is needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
