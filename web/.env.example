# EdgeBoard web app environment variables.
# Copy this file to `web/.env.local` and fill in real values.
#
# Only the browser-safe Supabase vars belong here. The read path uses the
# anon key only — keep SUPABASE_SERVICE_ROLE_KEY out of the web app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Waitlister.me waitlist key for the /early-access form (server-side proxy in app/api/waitlist).
# This is a public key (it ships in Waitlister's own embed snippets); the API route has a default,
# so this is only needed to point the form at a different waitlist.
WAITLISTER_KEY=
