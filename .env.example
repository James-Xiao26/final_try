# EdgeBoard environment variables.
# Copy this file to `.env.local` (same directory) and fill in real values.
#
# This root file is loaded by the ingestion pipeline (scripts/ingest.ts loads
# `../.env.local` then its own local `.env.local`). The web app reads its own
# web/.env.local — see web/.env.example for the browser-safe subset.

# --- Supabase (shared) ---
# Browser-safe; used by both the web app and scripts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scripts only (writes) ---
# Service-role key has full DB access. NEVER expose this to the web app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the Polymarket Data API base URL.
# POLYMARKET_API_BASE=

# Optional: cadence gate for the FULL ingest pass (scripts/ingest.ts, no flags).
# Heroku Scheduler can't express "every N hours", so schedule `pnpm ingest`
# HOURLY and set this to the desired interval — the pass runs only when the UTC
# hour is a multiple of this value (4 → 00/04/08/12/16/20 UTC); other hourly
# invocations exit in seconds. Unset/0 = run on every invocation.
# Does not affect --feed-only / --markets-only (those run on their own schedule).
# FULL_INGEST_EVERY_HOURS=4
