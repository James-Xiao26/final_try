{
  "name": "edgeboard",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter edgeboard-web dev",
    "build": "pnpm --filter edgeboard-web build",
    "typecheck": "pnpm --recursive run typecheck",
    "ingest": "pnpm --filter edgeboard-scripts ingest",
    "ingest:feed": "pnpm --filter edgeboard-scripts ingest:feed",
    "ingest:markets": "pnpm --filter edgeboard-scripts ingest:markets",
    "webhook": "pnpm --filter edgeboard-scripts webhook",
    "heroku-postbuild": "echo \"Scheduler-only deploy: skipping web build\""
  },
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "scripts",
    "web"
  ],
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
